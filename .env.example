# --- Database (Postgres + pgvector) ---
# Local dev: point DATABASE_URL at any reachable Postgres that has the
# `vector` extension enabled.
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mcp
#
# In production on Cloud Run, set CLOUD_SQL_CONNECTION_NAME + DB_USER /
# DB_PASSWORD / DB_NAME instead (see DEPLOYMENT.md) and the app builds the
# Cloud SQL Unix-socket URL automatically.
DATABASE_URL=
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# DB_USER=mcp-app
# DB_PASSWORD=
# DB_NAME=mcp

# Reuse the sibling "UAC" project's already-built collection by pointing
# DATABASE_URL at its Cloud SQL instance and keeping this default name.
# VECTOR_COLLECTION_NAME=uc_davis_ai

# Run the bulk ingestion of the bundled PDFs at startup if the collection is
# empty. Set false if you seed the DB out-of-band (recommended for prod:
# run `python -m knowledge_base.build_index` once).
SEED_ON_STARTUP=true

# --- MCP server ---
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8080

# --- Web search (DuckDuckGo, no key) ---
# WEB_SEARCH_REGION=us-en
# WEB_SEARCH_MAX_RESULTS=5

# --- Optional model overrides (defaults in core/config.py) ---
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_TOP_K=20
# RERANK_TOP_N=5
